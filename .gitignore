# .gitignore

node_modules/
# package-lock.json is committed per ADR-015 (dependency admission policy).
# .build-keys/ holds dev-only signing keys (H10, ADR-024) — never committed.
.build-keys/
*.db
*.db-journal
*.log
.env
.env.*
!.env.example
# H12: per-instance update runtime state (ADR-025) — the high-water mark is
# written by code only and must never be committed or shared between instances.
artifacts/update-state.json
artifacts/update-state.json.tmp
# H14 (ADR-033): the per-run report is instance output; the *baseline* is
# committed and deliberately re-blessed, because that is what makes drift loud.
artifacts/adversarial-report.json
