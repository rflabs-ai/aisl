{
  "name": "aisl",
  "version": "0.1.0",
  "description": "High-assurance AI execution environment: the model is not the authority, the infrastructure is.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "aisl": "./bin/aisl.mjs"
  },
  "files": [
    "src",
    "bin",
    "tools/manifests",
    "artifacts/sbom.json",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.ts\" \"security-tests/*.test.ts\"",
    "demo": "node src/cli.ts demo",
    "benchmark": "node src/cli.ts benchmark",
    "attack": "node src/cli.ts attack",
    "adversarial": "node src/cli.ts adversarial",
    "policy:diff": "node src/policy-diff.ts",
    "policy:analyze": "node src/cli.ts policy analyze",
    "policy:golden": "node src/cli.ts policy golden",
    "supply-chain": "node src/cli.ts build gate",
    "sbom": "node src/cli.ts build sbom",
    "build:keygen": "node src/cli.ts build keygen",
    "build:sign": "node src/cli.ts build sign",
    "build:verify": "node src/cli.ts build verify",
    "update:verify": "node src/cli.ts update verify",
    "update:status": "node src/cli.ts update status",
    "incident:status": "node src/cli.ts incident status",
    "evidence:status": "node src/cli.ts evidence status",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "jose": "6.2.12",
    "postgres": "3.4.9"
  }
}
