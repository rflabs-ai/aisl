#!/bin/sh
# Pre-commit gate. Tracked here because .git/hooks is not version controlled:
# install with `cp scripts/pre-commit .git/hooks/pre-commit && chmod +x`.
#
# Gate: supply-chain, typecheck, tests. Bypass only with `git commit --no-verify`
# and say why in the message.
#
# GIT_DIR HAZARD: while a hook runs, git exports GIT_DIR, GIT_WORK_TREE and
# GIT_INDEX_FILE into the environment. Any test that shells out to git in a
# temporary directory then operates on THIS repository instead of its own: a
# fixture's `git init --bare` once flipped core.bare on the whole checkout and a
# fixture's commit landed in this index. Unset them for the gate, so the test
# process sees an ordinary environment.

unset GIT_DIR
unset GIT_WORK_TREE
unset GIT_INDEX_FILE
unset GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES

echo "pre-commit: running supply-chain gate..."
npm run supply-chain
if [ $? -ne 0 ]; then
  echo "pre-commit: supply-chain gate FAILED. Commit blocked."
  exit 1
fi

echo "pre-commit: running typecheck..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "pre-commit: typecheck FAILED. Commit blocked."
  exit 1
fi

echo "pre-commit: running tests..."
npm test
if [ $? -ne 0 ]; then
  echo "pre-commit: tests FAILED. Commit blocked."
  exit 1
fi

echo "pre-commit: gate passed."
